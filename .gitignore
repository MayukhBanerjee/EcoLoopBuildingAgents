# Secrets / local env
.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Simulation / run outputs
# Ignore everything under data/ by default. Keep only frozen baseline,
# comparison KPIs for the dashboard, and a logs/agent_results skeleton.
# Closed-loop agent runs are regenerated by `main.py` and must NOT be
# committed (JSONL, CSVs, EP dumps, final IDFs, HTML, etc.).
# ---------------------------------------------------------------------------
data/*
!data/baseline_results/
!data/baseline_results/**
!data/logs/
!data/logs/**
!data/comparison/
!data/comparison/***
!data/logs/
!data/logs/**
!data/comparison/
!data/comparison/**
!data/agent_results/
!data/agent_results/.gitkeep

# Explicit agent / diagnostic trees (belt-and-suspenders; covered by data/* too)
data/agent/
data/agent_run/
data/agent_results/**
!data/agent_results/.gitkeep
data/bridge_*/
data/runtime_oracle/

