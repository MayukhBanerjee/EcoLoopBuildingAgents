# Secrets / local env
.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Simulation / run outputs
# Ignore everything under data/ by default. Keep only frozen baseline + logs
# skeleton. Agent closed-loop runs are regenerated by `main.py` and must NOT
# be committed (JSONL, CSVs, EP dumps, final IDFs, HTML, etc.).
# ---------------------------------------------------------------------------
data/*
!data/baseline_results/
!data/baseline_results/**
!data/logs/
!data/logs/**
!data/comparison/
!data/comparison/**
!data/agent_results/
!data/agent_results/.gitkeep

# Explicit agent run trees (belt-and-suspenders; covered by data/* too)
data/agent/
data/agent_run/
data/agent_results/**
!data/agent_results/.gitkeep

# EnergyPlus temporary and diagnostic files (anywhere in the repo)
*.audit
*.bnd
*.dbg
*.dxf
*.edd
*.eio
*.end
*.err
*.eso
*.mdd
*.mtd
*.mtr
*.rdd
*.rvaudit
*.shd
*.htm
*.html
*.log
eplusout.*
eplusmtr.*
eplusssz.*
epluszsz.*
sqlite.err

# EnergyPlus models and weather files (local install / large binaries)
energyplus/models/*.idf
energyplus/weather/*.epw
*.idf
*.epw

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/

# Streamlit
.streamlit/secrets.toml
