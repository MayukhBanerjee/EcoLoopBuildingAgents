*.html
*.log
eplusout.*
eplusmtr.*
eplusssz.*
epluszsz.*
sqlite.err
eplusout.*
eplusmtr.*
eplusssz.*
epluszsz.*
sqlite.err

# EnergyPlus models and weather files (local install / large binaries) (local install / large binaries)
energyplus/models/*.idf
energyplus/weather/*.epw
*.idf
*.epw

