# Copy to .env and fill in values

# --- LLM (open-source models via Groq, OpenAI-compatible API) ---
GROQ_API_KEY=gsk_your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.3-70b-versatile      # scored runs (100K tokens/day free)
DEV_MODEL_NAME=llama-3.1-8b-instant     # dev/tuning runs (500K tokens/day free)
# Offline backup: point base URL at Ollama instead
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1:8b

# --- EnergyPlus ---
ENERGYPLUS_DIR=C:\EnergyPlusV26-1-0
SIMULATION_TIMESTEP=15
MAX_LOOP_ITERATIONS=96
AGENT_EVERY_N_STEPS=1

# --- Grid / demand reasoning inputs ---
PEAK_DEMAND_THRESHOLD_KW=55.0
